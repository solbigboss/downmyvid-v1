# Optional backend configuration. Set these only in the server process environment.
# VITE_API_BASE_URL is public and baked into the frontend at build time.
VITE_API_BASE_URL=""

# Used by Express to access X's guest-token APIs. Never place this in VITE_* vars.
X_PUBLIC_BEARER=""

# Optional Instagram session cookies for backend-only extraction.
# Never commit real values or log their contents.
IG_SESSIONID=""
IG_CSRFTOKEN=""

# Backend media conversion limits
FFMPEG_MAX_CONCURRENT="2"
FFMPEG_TIMEOUT_MS="120000"
