{
  "manifest_version": 3,
  "name": "DownMyVid - 3D Video Downloader",
  "version": "1.0.5",
  "description": "Frictionless, 3D-styled video downloader for YouTube, X (Twitter), Instagram, Facebook, and TikTok.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.fb.com/*",
    "*://*.fb.watch/*",
    "*://*.tiktok.com/*",
    "https://downmyvid.com/*",
    "https://*.downmyvid.com/*",
    "https://downmyvid-meta-api.saddikos97.workers.dev/*",
    "https://api.fxtwitter.com/*",
    "https://api.vxtwitter.com/*",
    "https://backend1.tioo.eu.org/*",
    "https://www.tikwm.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DownMyVid Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "icons/logo.png"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.fb.watch/*",
        "*://*.tiktok.com/*"
      ]
    }
  ]
}
