rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBlogAdmin() {
      return request.auth != null && request.auth.token.email == 'journeysailblog@gmail.com';
    }

    // Blog Posts Collection
    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isBlogAdmin();
      allow create: if isBlogAdmin()
        && request.resource.data.authorEmail == 'journeysailblog@gmail.com'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140
        && request.resource.data.slug is string && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 300
        && request.resource.data.body is string && request.resource.data.body.size() <= 100000
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40
        && request.resource.data.published is bool;
      allow update: if isBlogAdmin()
        && request.resource.data.authorEmail == 'journeysailblog@gmail.com'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140
        && request.resource.data.slug is string && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 300
        && request.resource.data.body is string && request.resource.data.body.size() <= 100000
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40
        && request.resource.data.published is bool;
      allow delete: if isBlogAdmin();
    }

    // Guest Comments Collection (Adjacency List Pattern)
    match /comments/{commentId} {
      // Anyone can read approved comments; admin can read all (including pending/spam)
      allow read: if resource.data.status == 'approved' || isBlogAdmin();

      // Guest comment creation with strict validation
      allow create: if request.resource.data.post_slug is string
        && request.resource.data.post_slug.size() > 0 && request.resource.data.post_slug.size() <= 255
        && (request.resource.data.parent_id == null || request.resource.data.parent_id is string)
        && request.resource.data.guest_name is string && request.resource.data.guest_name.size() <= 100
        && request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000
        && request.resource.data.status in ['approved', 'pending', 'rejected', 'spam'];

      // Only blog admin can edit or remove comments (moderation)
      allow update, delete: if isBlogAdmin();
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Downloads subcollection for synced history
      match /downloads/{downloadId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(downloadId) && request.resource.data.userId == request.auth.uid;
        allow update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }
  }
}
